# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=
DATABASE_URL=postgres://regal:choose-a-password@localhost:5432/regal_cinema
# Leave the password empty to print emails to the console instead of
# sending them. The password is a Gmail app password, never the account's.
EMAIL_HOST_USER=testmessager3@gmail.com
EMAIL_HOST_PASSWORD=
# A Stripe test-mode key (sk_test_...). Never a live key.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the dashboard's endpoint for the live site.
STRIPE_WEBHOOK_SECRET=
